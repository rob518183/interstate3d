# Building Model - Interstate 3D
# Simple desert building structure

# Building base vertices
v -2.0 0.0 -2.0     # Front left bottom
v 2.0 0.0 -2.0      # Front right bottom
v 2.0 0.0 2.0       # Back right bottom
v -2.0 0.0 2.0      # Back left bottom

v -2.0 3.0 -2.0     # Front left top
v 2.0 3.0 -2.0      # Front right top
v 2.0 3.0 2.0       # Back right top
v -2.0 3.0 2.0      # Back left top

# Roof vertices (pyramid style)
v 0.0 4.5 0.0       # Roof peak

# Door vertices
v -0.5 0.0 -2.01    # Door left bottom
v 0.5 0.0 -2.01     # Door right bottom
v 0.5 2.0 -2.01     # Door right top
v -0.5 2.0 -2.01    # Door left top

# Window vertices (front)
v -1.5 1.5 -2.01    # Front window left
v -0.5 1.5 -2.01    # Front window right
v -0.5 2.5 -2.01    # Front window top right
v -1.5 2.5 -2.01    # Front window top left

v 0.5 1.5 -2.01     # Front window right (second)
v 1.5 1.5 -2.01     # Front window far right
v 1.5 2.5 -2.01     # Front window top far right
v 0.5 2.5 -2.01     # Front window top right (second)

# Texture coordinates
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vt 0.5 0.0
vt 0.75 0.25
vt 1.0 0.5
vt 0.75 0.75
vt 0.5 1.0
vt 0.25 0.75
vt 0.0 0.5
vt 0.25 0.25

# Vertex normals
vn 0.0 -1.0 0.0
vn 0.0 1.0 0.0
vn 0.0 0.0 -1.0
vn 0.0 0.0 1.0
vn -1.0 0.0 0.0
vn 1.0 0.0 0.0
vn 0.0 0.707 -0.707
vn 0.0 0.707 0.707
vn -0.707 0.707 0.0
vn 0.707 0.707 0.0

# Building base faces
f 1/1/1 2/2/1 6/2/2 5/1/2
f 2/2/1 3/3/1 7/3/2 6/2/2
f 3/3/1 4/4/1 8/4/2 7/3/2
f 4/4/1 1/1/1 5/1/2 8/4/2

# Building top and bottom
f 5/1/2 6/2/2 7/3/2 8/4/2
f 4/4/1 3/3/1 2/2/1 1/1/1

# Pyramid roof faces
f 5/5/2 6/6/2 9/6/7
f 6/6/2 7/7/2 9/7/10
f 7/7/2 8/8/2 9/8/8
f 8/8/2 5/5/2 9/5/9

# Door (inset in front wall)
f 10/9/3 11/10/3 12/10/3 13/9/3

# Windows (inset in front wall)
f 14/11/3 15/12/3 16/12/3 17/11/3
f 18/11/3 19/12/3 20/12/3 21/11/3

# Create window and door holes in front wall
# Front wall with openings (split into sections)
f 1/1/3 10/9/3 13/9/3 5/1/3
f 10/9/3 14/11/3 17/11/3 13/9/3
f 17/11/3 15/12/3 11/10/3 13/9/3
f 11/10/3 18/11/3 21/11/3 12/10/3
f 12/10/3 19/12/3 2/2/3 6/2/3
f 18/11/3 21/11/3 20/12/3 19/12/3
